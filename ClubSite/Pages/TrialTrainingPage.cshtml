@page
@model ClubSite.Pages.TrialTrainingPageModel
@{
    // Disable caching in order to make AntiForgeryToken work
    HttpContext.Response.Headers.Remove("Cache-Control");
    HttpContext.Response.Headers.Remove("Pragma");
    HttpContext.Response.Headers.TryAdd("Cache-Control", "no-store, no-cache, must-revalidate");
    HttpContext.Response.Headers.TryAdd("Pragma", "no-cache");
}
<div class="mx-3 py-2">
    @{
        ViewData["Title"] = "Probetraining vereinbaren";

        List<SelectListItem> GenderList()
        {
            return new()
            {
                new SelectListItem { Value = string.Empty, Text = "keine Angabe" },
                new SelectListItem { Value = "f", Text = "Frau" },
                new SelectListItem { Value = "m", Text = "Herr" }
            };
        }

        List<SelectListItem> GenderInfoList()
        {
            return new()
            {
                new SelectListItem { Value = string.Empty, Text = "keine Angabe" },
                new SelectListItem { Value = "m", Text = "männlich" },
                new SelectListItem { Value = "w", Text = "weiblich" },
                new SelectListItem { Value = "d", Text = "divers" }
            };
        }

        List<SelectListItem> ExperienceList()
        {
            return new()
            {
                new SelectListItem { Value = string.Empty, Text = "Bitte auswählen" },
                new SelectListItem { Value = "beginner", Text = "Anfänger" },
                new SelectListItem { Value = "some-experience", Text = "geringe Erfahrung" },
                new SelectListItem { Value = "hobby", Text = "Hobbyniveau" },
                new SelectListItem { Value = "advanced", Text = "fortgeschritten" },
                new SelectListItem { Value = "club-player", Text = "Vereinsspieler" }
            };
        }

        List<SelectListItem> TeamList()
        {
            return new()
            {
                new SelectListItem { Value = "none", Text = "keine Präferenz" },
                new SelectListItem { Value = "mixed", Text = "Mixed" },
                new SelectListItem { Value = "women", Text = "Damen" },
                new SelectListItem { Value = "men", Text = "Herren" },
                new SelectListItem { Value = "youth", Text = "Jugendliche" }
            };
        }

        List<SelectListItem> GoalList()
        {
            return new()
            {
                new SelectListItem { Value = "other", Text = "Sonstiges" },
                new SelectListItem { Value = "active", Text = "Aktiv spielen in einer Mannschaft" },
                new SelectListItem { Value = "train-only", Text = "Nur trainieren" },
                new SelectListItem { Value = "explore", Text = "Erstmal kennenlernen" }
            };
        }
    }
    <div>
        <h2 class="h2">@ViewData["Title"]</h2>
        <h4 class="h4">Unverbindliches Probetraining beim VC Neusäss</h4>
        <p class="text-muted">
            Du möchtest Volleyball ausprobieren? Dann melde dich bei uns an.
            Wir melden uns in Kürze bei dir mit einem passenden Terminvorschlag.
        </p>
        <hr />
    </div>
    <div class="mb-4">
        <form method="post" class="col-md-8 col-sm-10 col-12 ps-0" role="form" novalidate>
            <div asp-validation-summary="All" class="rounded alert alert-danger border-danger">
            </div>

            <fieldset class="border rounded p-3 mb-4">
                <legend class="h5">Probetraining für</legend>

                <div class="col-md-6">
                    <label asp-for="Gender" class="form-label"></label>
                    <select asp-for="Gender" asp-items="GenderList()" class="form-select" required="required"></select>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="GenderInfo" class="form-label"></label>
                    <select asp-for="GenderInfo" asp-items="GenderInfoList()" class="form-select" required="required"></select>
                    <span asp-validation-for="GenderInfo" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" type="text" required="required" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" type="text" required="required" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" required="required" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" type="text" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
            </fieldset>

            <fieldset class="border rounded p-3 mb-4">
                <legend class="h5">Trainings-Präferenzen</legend>

                <div class="col-md-3">
                    <label asp-for="Age" class="form-label"></label>
                    <input asp-for="Age" type="number" min="1" max="120" required="required" class="form-control" />
                    <span asp-validation-for="Age" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Experience" class="form-label"></label>
                    <select asp-for="Experience" asp-items="ExperienceList()" class="form-select" required="required"></select>
                    <span asp-validation-for="Experience" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TeamPreference" class="form-label"></label>
                    <select asp-for="TeamPreference" asp-items="TeamList()" class="form-select" required="required"></select>
                    <span asp-validation-for="TeamPreference" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Goal" class="form-label"></label>
                    <select asp-for="Goal" asp-items="GoalList()" class="form-select" required="required"></select>
                    <span asp-validation-for="Goal" class="text-danger"></span>
                </div>
            </fieldset>

            <fieldset class="border rounded p-3 mb-4">
                <legend class="h5">Weitere Angaben</legend>

                <div>
                    <label asp-for="Comment" class="form-label"></label>
                    <textarea asp-for="Comment" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>
            </fieldset>

            <fieldset class="border rounded p-3 mb-4">
                <legend class="h5">Sicherheitsabfrage</legend>

                <div class="col-md-6">
                    <div class="mt-2">
                        <img id="CaptchaImage" style="vertical-align: bottom; display: inline"
                             src="@Url.Action(nameof(Controllers.Captcha.Index), nameof(Controllers.Captcha))@("?guid=" + Guid.NewGuid())"
                             alt="Captcha" title="" />
                        <label class="d-inline" onclick="javascript:if (document.images) document.images.CaptchaImage.src = '@Url.Action(nameof(Controllers.Captcha.Index), nameof(Controllers.Captcha))?new=1&amp;time=' + new Date().getTime();" style="cursor: pointer">
                            <i class="fas fa-sync-alt fa-2x" style="margin: 0 5px 0 5px;" title="Neu laden"></i>
                        </label><br />
                    </div>
                    <label asp-for="Captcha" class="form-label"></label>
                    <div>
                        <div class="input-group">
                            <input asp-for="Captcha" required="required" type="text" class="form-control" maxlength="7" autocomplete="off" />
                            <span class="input-group-text">
                                <strong style="font-size: 1rem">=</strong>
                            </span>
                        </div>
                        <span asp-validation-for="Captcha" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <div class="mt-4">
                <button type="submit" formaction="@Model.Data.Permalink" class="btn btn-lg btn-primary" style="width: 100%">Anfrage senden</button>
            </div>
        </form>
    </div>
</div>
@section script {
    <script type="text/javascript">
        //<![CDATA[
        var textbox = document.getElementById('@Html.NameFor(m => m.Email)');
        if (textbox)
            textbox.focus();
        //]]>
    </script>
}
