@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Logging
@using Piranha.Cache
@inject IConfiguration Configuration
@inject ICache Cache
@inject ILoggerFactory LoggerFactory
@{
    var logger = LoggerFactory.CreateLogger("FloatingRegisterTab");
    const string cacheKey = "floating-register-tab-cache";
    const string text = "🏐 Beitreten";

    async Task<string?> GetDocumentUrlCached(string folderName, string fileName)
    {
        var cachedUrl = await Cache.GetAsync<string>(cacheKey);
        if (cachedUrl is not null) return cachedUrl;

        var folders = await WebApp.Api.Media.GetAllFoldersAsync();
        var folder = folders.FirstOrDefault(f => f.Name == folderName);
        var docs = await WebApp.Api.Media.GetAllByFolderIdAsync(folder?.Id);
        var doc = docs?.FirstOrDefault(n => n.Filename == fileName);
        var publicUrl = doc?.PublicUrl;
        await Cache.SetAsync(cacheKey, publicUrl);
        return publicUrl;
    }

    string? publicUrl;
    try
    {
        // Read from appsettings.json
        var folder = Configuration["FloatingRegisterTab:FolderName"] ?? "";
        var file = Configuration["FloatingRegisterTab:FileName"] ?? "";

        publicUrl = await GetDocumentUrlCached(folder, file);
        if (publicUrl is null)
        {
            logger.LogError("Register tab document not found: '{Folder}/{File}'", folder, file);
            return; // exit without rendering the tab
        }
    }
    catch (Exception e)
    {
        logger.LogError(e, "Error getting register tab url");
        return; // exit without rendering the tab
    }
}
<style>
    .floating-register-tab {
        position: fixed;
        top: 40%;
        right: 0;
        transform: translateY(-50%);
        z-index: 9999;
        writing-mode: vertical-rl;
        text-orientation: mixed;
        padding: 14px 8px;
        border-radius: 8px 0 0 8px;
        text-decoration: none;
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: 0.5px;
        box-shadow: -2px 2px 10px rgba(0,0,0,0.25);
        transition: right 0.3s ease, box-shadow 0.3s ease;
        line-height: 1.3;
        color: #fff !important;
        background: #dc3545;
        border: none;
        display: inline-block;
    }
    .floating-register-tab:hover {
        right: 4px;
        box-shadow: -4px 4px 14px rgba(0,0,0,0.35);
        text-decoration: none;
        color: #fff !important;
    }
</style>
<a href="@Url.Content(publicUrl)"
   class="floating-register-tab"
   target="_blank"
   rel="">
    @text
</a>
