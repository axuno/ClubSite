@{
    // Floating shortcut tab — hardcoded link, no configuration needed.
    // Change the values below if the link target or text should be updated.
    var link = "/uploads/b59b88bb-4289-4604-9727-0da3dade275a/Beitrittserkl%c3%a4rung_ab_26.07.2026.pdf";
    var text = "🏐 Beitreten";
    var bgColor = "#dc3545";
}
<style>
    .floating-register-tab {
        position: fixed;
        top: 40%;
        right: 0;
        transform: translateY(-50%);
        z-index: 9999;
        writing-mode: vertical-rl;
        text-orientation: mixed;
        padding: 14px 8px;
        border-radius: 8px 0 0 8px;
        text-decoration: none;
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: 0.5px;
        box-shadow: -2px 2px 10px rgba(0,0,0,0.25);
        transition: right 0.3s ease, box-shadow 0.3s ease;
        line-height: 1.3;
        color: #fff !important;
        background: @bgColor;
        border: none;
        display: inline-block;
    }
    .floating-register-tab:hover {
        right: 4px;
        box-shadow: -4px 4px 14px rgba(0,0,0,0.35);
        text-decoration: none;
        color: #fff !important;
    }
</style>
<a href="@link"
   class="floating-register-tab"
   target="_self"
   rel="">
    @text
</a>