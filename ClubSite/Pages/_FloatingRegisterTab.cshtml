@using Piranha.Models
@using Piranha
@{
    // Floating shortcut tab — configurable via PIRANHA Manager → Params.
    // Create params: shortcut-tab-enabled, shortcut-tab-link, shortcut-tab-text,
    // shortcut-tab-color, shortcut-tab-hide-mobile
    var enabled = false;
    var link = "";
    var text = "";
    var bgColor = "#dc3545";
    var hideMobile = false;

    try
    {
        var enabledParam = await WebApp.Api.Params.GetByKeyAsync("shortcut-tab-enabled");
        var linkParam = await WebApp.Api.Params.GetByKeyAsync("shortcut-tab-link");
        var textParam = await WebApp.Api.Params.GetByKeyAsync("shortcut-tab-text");
        var colorParam = await WebApp.Api.Params.GetByKeyAsync("shortcut-tab-color");
        var hideMobileParam = await WebApp.Api.Params.GetByKeyAsync("shortcut-tab-hide-mobile");

        enabled = enabledParam?.Value?.Trim() == "true";
        link = linkParam?.Value ?? "";
        text = textParam?.Value ?? "";
        bgColor = colorParam?.Value ?? "#dc3545";
        hideMobile = hideMobileParam?.Value?.Trim() == "true";
    }
    catch
    {
        // Silently fail
    }
}

@if (enabled && !string.IsNullOrWhiteSpace(link))
{
    var hideClass = hideMobile ? "d-none d-sm-block" : "";
    var isExternal = link.StartsWith("http://") || link.StartsWith("https://");
    <style>
        .floating-register-tab {
            position: fixed;
            top: 40%;
            right: 0;
            transform: translateY(-50%);
            z-index: 9999;
            writing-mode: vertical-rl;
            text-orientation: mixed;
            padding: 14px 8px;
            border-radius: 8px 0 0 8px;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: 0.5px;
            box-shadow: -2px 2px 10px rgba(0,0,0,0.25);
            transition: right 0.3s ease, box-shadow 0.3s ease;
            line-height: 1.3;
            color: #fff !important;
            background: @bgColor;
            border: none;
            display: inline-block;
        }
        .floating-register-tab:hover {
            right: 4px;
            box-shadow: -4px 4px 14px rgba(0,0,0,0.35);
            text-decoration: none;
            color: #fff !important;
        }
    </style>
    <a href="@link"
       class="floating-register-tab @hideClass"
       target="@(isExternal ? "_blank" : "_self")"
       rel="@(isExternal ? "noopener noreferrer" : "")">
        @text
    </a>
}