@page "~/manager/settings/shortcut-tab"
@model ClubSite.Areas.Manager.Pages.ShortcutTabModel
@inject ManagerLocalizer Localizer
@{
    ViewBag.Title = "Shortcut Tab";
    ViewBag.MenuItem = "Settings";
}

<div id="shortcut-tab">
    <div class="top">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">@Localizer.Menu["Settings"]</li>
                <li class="breadcrumb-item active" aria-current="page">Shortcut Tab</li>
            </ol>
        </nav>
    </div>

    <div class="container-fluid mb-3 app">
        <form method="post" id="shortcutTabForm" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()

            <div class="card">
                <div class="card-header">
                    <span class="title">Floating Shortcut Tab</span>
                </div>
                <div class="card-body">
                    <p class="text-secondary">
                        Configure the floating shortcut tab that appears on the right edge of every page.
                        The tab is rendered by <code>_FloatingRegisterTab.cshtml</code> and reads its
                        values from Piranha Params.
                    </p>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <div class="row align-items-end">
                                <div class="col-md-8">
                                    <strong class="d-block">@Html.DisplayNameFor(m => m.Enabled)</strong>
                                    <span class="text-secondary">
                                        Show the floating shortcut tab on the site.
                                    </span>
                                </div>
                                <div class="col-md-4">
                                    <button type="button" class="switch switch-lg toggle-switch"
                                            data-target="@Html.IdFor(m => m.Enabled)"
                                            aria-pressed="@Model.Enabled.ToString().ToLower()">
                                        <span></span>
                                    </button>
                                    <input type="hidden" name="@Html.NameFor(m => m.Enabled)" value="false" />
                                    <input asp-for="Enabled" type="checkbox" class="d-none" />
                                </div>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="row align-items-end">
                                <div class="col-md-8">
                                    <strong class="d-block">@Html.DisplayNameFor(m => m.Link)</strong>
                                    <span class="text-secondary">
                                        Link target for the tab — a page path like <code>/mitglied-werden</code>,
                                        a PDF path, or an external URL.
                                    </span>
                                </div>
                                <div class="col-md-4">
                                    <input asp-for="Link" class="form-control" type="text" placeholder="/mitglied-werden" />
                                    <span asp-validation-for="Link" class="text-danger"></span>
                                </div>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="row align-items-end">
                                <div class="col-md-8">
                                    <strong class="d-block">@Html.DisplayNameFor(m => m.Text)</strong>
                                    <span class="text-secondary">
                                        Button text displayed on the tab, e.g. <code>🏐 Beitreten</code>.
                                    </span>
                                </div>
                                <div class="col-md-4">
                                    <input asp-for="Text" class="form-control" type="text" placeholder="🏐 Beitreten" />
                                    <span asp-validation-for="Text" class="text-danger"></span>
                                </div>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="row align-items-end">
                                <div class="col-md-8">
                                    <strong class="d-block">@Html.DisplayNameFor(m => m.Color)</strong>
                                    <span class="text-secondary">
                                        Background color for the tab in hex format, e.g. <code>#dc3545</code>.
                                    </span>
                                </div>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input asp-for="Color" class="form-control" type="color"
                                               style="max-width: 52px; min-height: 38px; padding: 2px; cursor: pointer" />
                                        <input asp-for="Color" class="form-control" type="text"
                                               placeholder="#dc3545" style="flex: 1; font-family: monospace" id="colorText" />
                                    </div>
                                    <span asp-validation-for="Color" class="text-danger"></span>
                                </div>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="row align-items-end">
                                <div class="col-md-8">
                                    <strong class="d-block">@Html.DisplayNameFor(m => m.HideMobile)</strong>
                                    <span class="text-secondary">
                                        Hide the tab on small screens (phones).
                                    </span>
                                </div>
                                <div class="col-md-4">
                                    <button type="button" class="switch switch-lg toggle-switch"
                                            data-target="@Html.IdFor(m => m.HideMobile)"
                                            aria-pressed="@Model.HideMobile.ToString().ToLower()">
                                        <span></span>
                                    </button>
                                    <input type="hidden" name="@Html.NameFor(m => m.HideMobile)" value="false" />
                                    <input asp-for="HideMobile" type="checkbox" class="d-none" />
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
                <div class="card-footer text-right">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check"></i>
                        Save settings
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section script {
    <script>
        (function () {
            'use strict';

            // Toggle switch buttons
            document.querySelectorAll('.toggle-switch').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var checkbox = document.getElementById(this.getAttribute('data-target'));
                    checkbox.checked = !checkbox.checked;
                    this.setAttribute('aria-pressed', checkbox.checked);
                });
            });

            // Sync color picker and text input
            var colorInput = document.querySelector('input[type="color"][asp-for="Color"]');
            var colorText = document.getElementById('colorText');
            if (colorInput && colorText) {
                colorInput.addEventListener('input', function () {
                    colorText.value = this.value;
                });
                colorText.addEventListener('input', function () {
                    if (/^#[0-9a-f]{6}$/i.test(this.value)) {
                        colorInput.value = this.value;
                    }
                });
            }

            // Form validation (Piranha standard)
            window.addEventListener('load', function () {
                var form = document.getElementById('shortcutTabForm');
                if (form) {
                    form.addEventListener('submit', function (event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                }
            });
        })();
    </script>
}